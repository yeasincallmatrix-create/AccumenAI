APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Phase 9 lab analyzer integration: set BROADCAST_CONNECTION=reverb to go
# live (Reverb server must run: php artisan reverb:start). Default stays log.
REVERB_APP_ID=accumenai-lab
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production SMTP (Gmail) — set in .env only, never in code
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=your_gmail_address
# MAIL_PASSWORD=your_app_password
# MAIL_FROM_ADDRESS=your_gmail_address
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh
BKASH_SANDBOX=true
BKASH_CALLBACK_URL="${APP_URL}/saas/callback"
BKASH_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/AccumenAI/public/auth/google/callback

# Google Drive backup storage OAuth callback (register in Google Console)
GOOGLE_DRIVE_REDIRECT_URI=http://localhost/AccumenAI/public/tenant/backup/drive/callback

# Tenant backup encryption - NEVER lose this key (loss = backups unrecoverable)
BACKUP_MASTER_KEY=
BACKUP_RETENTION_DAYS=365
BACKUP_KEEP_PER_TENANT=1

# Phase 2A: content-addressed chunked backup
BACKUP_CHUNK_ENABLED=true
BACKUP_CHUNK_SIZE_SMALL_MB=5
BACKUP_CHUNK_SIZE_MEDIUM_MB=20
BACKUP_CHUNK_SIZE_LARGE_MB=50
BACKUP_TRASH_GRACE_DAYS=7
BACKUP_MANIFEST_BACKUP_WEEKS=4
DB_QUEUE_RETRY_AFTER=3660
BACKUP_LOCK_TTL_SECONDS=3660
BACKUP_LOCK_WAIT_SECONDS=0
BACKUP_VALIDATE_BEFORE_COMMIT=true
BACKUP_SAMPLE_CHUNK_PCT=10
