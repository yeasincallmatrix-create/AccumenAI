<?php

namespace App\Services;

use App\Models\Course;
use App\Models\RegNoSequence;
use App\Models\Student;
use Illuminate\Database\QueryException;
use Illuminate\Support\Facades\DB;

/**
 * The single registration-number generator (Step 36 / Phase 7).
 *
 * Format (always 12 characters, leading zeros preserved):
 *   YY   = admission year           (2 digits)
 *   ZZZZ = Bangladesh postal/ZIP    (4 digits)
 *   TTT  = trade/course code        (3 digits)
 *   SSS  = sequential student no.   (3 digits, per Year + ZIP + Trade)
 *
 * The counter is the existing reg_no_sequence table (fixed in place rather than
 * inventing a second generator). The sequence is platform-global per
 * Year+ZIP+Trade, so SSS never repeats for the same prefix and the composed
 * number never collides under the existing global unique registration_number
 * rule. Only one number is ever issued; it never overwrites an existing one.
 */
class RegistrationNumberService
{
    public function generate(string $year, string $zip, string $trade): string
    {
        $year = $this->segment($year, 2);
        $zip = $this->segment($zip, 4);
        $trade = $this->segment($trade, 3);

        $prefix = $year.$zip.$trade;
        $seq = $this->next($year, $zip, $trade);

        // Skip any value already taken (e.g. a legacy manually-entered number
        // that happens to match this prefix) instead of failing the unique rule.
        while ($this->taken($prefix.str_pad((string) $seq, 3, '0', STR_PAD_LEFT)) && $seq < 999) {
            $seq = $this->next($year, $zip, $trade);
        }

        return $prefix.str_pad((string) $seq, 3, '0', STR_PAD_LEFT);
    }

    private function taken(string $number): bool
    {
        return Student::withoutGlobalScopes()
            ->withTrashed()
            ->where('registration_number', $number)
            ->exists();
    }

    /**
     * Issue a registration number for a student when one is genuinely missing
     * and a course is known (applied course or latest enrollment). Never
     * overwrites a manually-entered number.
     */
    public function ensureFor(Student $student): void
    {
        if (filled($student->registration_number)) {
            return;
        }

        $course = $student->appliedCourse;
        if ($course === null) {
            $course = $student->enrollments()->latest('id')->first()?->batch?->course;
        }

        if ($course === null) {
            return;
        }

        $year = $student->admission_date?->format('y') ?? now()->format('y');
        $zip = $student->present_zip_code
            ?? $student->institute?->postal_code
            ?? '0000';

        $student->update([
            'registration_number' => $this->generate((string) $year, (string) $zip, $this->tradeCode($course)),
        ]);
    }

    public function tradeCode(Course $course): string
    {
        // The numeric part of the course code (e.g. MAWA-001 -> 001) is the
        // trade code; anything else degrades to the course id's last digits so
        // the result is always a stable 3-digit code.
        $digits = preg_replace('/\D/', '', (string) $course->course_code);
        if (filled($digits)) {
            return substr(str_pad($digits, 3, '0', STR_PAD_LEFT), -3);
        }

        return str_pad((string) ($course->id % 1000), 3, '0', STR_PAD_LEFT);
    }

    /**
     * Atomic next sequence value for one (year, zip, trade) combo, shared
     * across the whole platform. First use seeds the combo with 1; a concurrent
     * seeder simply retries on the row that won the race.
     */
    private function next(string $year, string $zip, string $trade): int
    {
        return DB::transaction(function () use ($year, $zip, $trade) {
            while (true) {
                $updated = DB::table('reg_no_sequence')
                    ->where('year_code', $year)
                    ->where('zip_code', $zip)
                    ->where('trade_code', $trade)
                    ->increment('last_sequence');

                if ($updated > 0) {
                    return (int) DB::table('reg_no_sequence')
                        ->where('year_code', $year)
                        ->where('zip_code', $zip)
                        ->where('trade_code', $trade)
                        ->value('last_sequence');
                }

                try {
                    RegNoSequence::create([
                        'year_code' => $year,
                        'zip_code' => $zip,
                        'trade_code' => $trade,
                        'last_sequence' => 1,
                    ]);

                    return 1;
                } catch (QueryException $e) {
                    // Another process seeded the same combo between our failed
                    // increment and insert — loop and take its value instead.
                    if ((int) $e->errorInfo[1] !== 1062) {
                        throw $e;
                    }
                }
            }
        });
    }

    private function segment(string $value, int $length): string
    {
        $digits = preg_replace('/\D/', '', $value);

        return substr(str_pad((string) $digits, $length, '0', STR_PAD_LEFT), 0, $length);
    }
}
