<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Model;

/**
 * Per-combo counter behind the 12-digit registration number
 * (YY + ZZZZ + TTT + SSS). The row key (year_code, zip_code, trade_code) is
 * platform-global so SSS is sequential per Year + ZIP + Trade and the composed
 * number stays unique under the global uq_students_registration_number rule.
 */
class RegNoSequence extends Model
{
    protected $table = 'reg_no_sequence';

    public $timestamps = false;

    protected $guarded = [];
}
