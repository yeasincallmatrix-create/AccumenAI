# AccumenAI Lab Gateway Configuration

# Server
LIS_BASE_URL=https://your-accumenai-server.com
LIS_API_PATH=/api/lab-gateway

# Device credentials (issued via LIS admin panel)
DEVICE_TOKEN=REPLACE_WITH_TOKEN_FROM_ADMIN
ANALYZER_ID=1
ANALYZER_CODE=SYSMEX-XN-550-LAB1

# Transport (tcp | serial | file)
TRANSPORT=tcp
TCP_HOST=0.0.0.0
TCP_PORT=5000
SERIAL_PORT=COM3
SERIAL_BAUD=9600
FILE_WATCH_PATH=/var/lab/incoming

# Local outbox
OUTBOX_DB_PATH=./data/outbox.sqlite

# Logging
LOG_LEVEL=info
